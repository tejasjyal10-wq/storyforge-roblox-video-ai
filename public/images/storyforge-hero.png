.hero {
  position: relative;
  min-height: 90vh;
  display: flex;
  align-items: center;
  overflow: hidden;
  background:
    linear-gradient(
      90deg,
      rgba(5, 5, 5, 0.96) 0%,
      rgba(5, 5, 5, 0.72) 45%,
      rgba(5, 5, 5, 0.15) 100%
    ),
    url("/images/storyforge-hero.png");

  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
}
